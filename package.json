{
  "name": "@murkio/vue",
  "version": "0.1.0",
  "description": "Murkio identity for Vue 3: the login canvas and the email, password, keep-logged, login and register components, plus auth composables.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViitoJooj/murkio-vue.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "package:check": "publint --strict",
    "prepublishOnly": "node scripts/check-publishable.mjs"
  },
  "dependencies": {
    "@murkio/html": "github:ViitoJooj/murkio-html#4ccc8ea80507f56b11249a0a67045f93df4adfdd"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.4",
    "happy-dom": "20.14.5",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild": false,
    "github:ViitoJooj/murkio-html#4ccc8ea80507f56b11249a0a67045f93df4adfdd": true
  }
}
